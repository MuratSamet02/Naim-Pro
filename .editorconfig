root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140

# Compose UI functions are PascalCase by convention, so the naming rule is
# relaxed for anything annotated with @Composable.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Import ordering is handled by the IDE formatter and would otherwise fight it.
ktlint_standard_no-wildcard-imports = enabled

[*.{yml,yaml,json,md}]
indent_size = 2

[*.xml]
indent_size = 4
