    <string name="about_intro">Naim Pro is an ad-free, tracker-free prayer times app that works completely offline and is fully open source.</string>
    <string name="about_offline">Fully offline</string>
    <string name="about_offline_desc">Times are computed on your device. More than 19,000 settlements ship with the app; no internet needed.</string>
    <string name="about_privacy">Privacy first</string>
    <string name="about_privacy_desc">No ads, analytics, crash reports or accounts. Location is approximate, requested only with your consent, and never leaves the device.</string>
    <string name="about_license">Free software</string>
    <string name="about_license_desc">Licensed under GPL-3.0. You may inspect, modify and share the code.</string>
    <string name="about_credits">Credits</string>
    <string name="about_credits_desc">City data from GeoNames (CC BY 4.0). All sounds are originally synthesised. Time comparisons were calibrated against Diyanet public data.</string>
